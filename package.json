	"repository": {
		"type": "git",
		"url": "https://github.com/gusdeboer/random-profiles-mcp.git"
	},
	"homepage": "https://random-profiles.com",
	"bugs": {
		"url": "https://github.com/gusdeboer/random-profiles-mcp/issues"
	}
